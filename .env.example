# DeepShield Environment Configuration
# Copy to .env and customize

# ─── Environment ────────────────────────────────────────
DEEPSHIELD_ENV=development
DEEPSHIELD_DEBUG=true

# ─── Model Configuration ────────────────────────────────
DEEPSHIELD_MODEL__DEVICE=auto
DEEPSHIELD_MODEL__FORGERY_DETECTOR=xception
DEEPSHIELD_MODEL__FACE_DETECTOR=retinaface
DEEPSHIELD_MODEL__BATCH_SIZE=16
DEEPSHIELD_MODEL__FP16=true
DEEPSHIELD_MODEL__CONFIDENCE_THRESHOLD=0.5

# ─── API ────────────────────────────────────────────────
DEEPSHIELD_API__HOST=0.0.0.0
DEEPSHIELD_API__PORT=8000
DEEPSHIELD_API__WORKERS=4

# ─── Database ───────────────────────────────────────────
DEEPSHIELD_DATABASE__URL=sqlite:///data/deepshield.db

# ─── Redis ──────────────────────────────────────────────
DEEPSHIELD_REDIS__URL=redis://localhost:6379/0

# ─── Logging ────────────────────────────────────────────
DEEPSHIELD_LOGGING__LEVEL=INFO
DEEPSHIELD_LOGGING__FORMAT=json
